# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Optional. Defaults to 3000 for local and container execution.
PORT="3000"

# AEGIS_API_TOKEN: Required for protected backend routes.
# Provide a real value only through local/runtime secret configuration.
# Do not commit real tokens. In ECS, prefer Secrets Manager injection.
AEGIS_API_TOKEN="REPLACE_WITH_RUNTIME_SECRET"

# AWS_PROFILE: Named AWS CLI profile used by the standard AWS SDK credential provider chain.
# Optional for local development. Do not use AWS_PROFILE in ECS; use a task IAM role.
AWS_PROFILE="aegis"

# AWS_REGION: Region for live Aegis AWS integration resources.
AWS_REGION="ap-southeast-2"

# AVP_POLICY_STORE_ID: Amazon Verified Permissions policy store ID for the Aegis Cedar policy.
AVP_POLICY_STORE_ID="YOUR_AVP_POLICY_STORE_ID"

# AEGIS_EVENT_BUS: EventBridge bus used by the current PutEvents publisher.
AEGIS_EVENT_BUS="default"

# AEGIS_DYNAMODB_TABLE: DynamoDB table used by the current evidence PutItem path.
AEGIS_DYNAMODB_TABLE="AegisEvidence"

# AEGIS_S3_BUCKET: S3 bucket created with Object Lock enabled for evidence archival.
AEGIS_S3_BUCKET="YOUR_AEGIS_EVIDENCE_BUCKET"

# BEDROCK_MODEL_ID: Active Bedrock model or inference profile ID for post-hoc investigation.
BEDROCK_MODEL_ID="YOUR_ACTIVE_BEDROCK_MODEL_OR_INFERENCE_PROFILE_ID"
